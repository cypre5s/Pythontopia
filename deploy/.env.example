# Pythontopia Docker Compose 环境变量样板。
# 用法：cp .env.example .env 并按需填入真实值，.env 不入 git。

# Postgres
PYT_DB_USERNAME=pytopia
PYT_DB_PASSWORD=pytopia_dev_password

# Backend
PYT_JWT_SECRET=replace-with-local-secret-at-least-32-chars
PYT_TEACHER_INVITE_CODE=pytopia-teacher

# RAG / 服务间内部令牌（backend → graph/rag 的 X-Internal-Token，必填）。
# graph 服务现在 fail-closed：未配置此令牌即拒绝所有非公共请求（503），不再「裸奔」。
PYT_RAG_ADMIN_TOKEN=pytopia-rag-admin
PYT_RAG_EMBEDDER=hash
# 仅本地无令牌调试 graph 时可设为 1 放行内部鉴权（绝不用于生产；compose/ECS 均已配令牌，无需设置）。
# PYT_INTERNAL_AUTH_OPTIONAL=1

# Graph LLM Provider 切换
# 可选值: dryrun（默认，本地无 LLM）、openai_compat、spark
PYT_LLM_PROVIDER=dryrun

# 当 PYT_LLM_PROVIDER=openai_compat 时填写
PYT_OPENAI_BASE_URL=
PYT_OPENAI_API_KEY=
# 默认档：答疑 / 工坊等重推理任务（质量优先）
PYT_OPENAI_MODEL=
# 快档（可选）：仅 NPC 寒暄/对话用，低延迟优先；留空则回落默认档
PYT_OPENAI_MODEL_FAST=

# 当 PYT_LLM_PROVIDER=spark 时填写（演示主链路）
PYT_SPARK_APP_ID=
PYT_SPARK_API_KEY=
PYT_SPARK_API_SECRET=
PYT_SPARK_MODEL_ID=

# 多模态生成（文生图 / 合成短视频 / TTS / 理解图片）—— 复用上面同一套讯飞 PYT_SPARK_* 凭据。
# 理解图片控制台：https://console.xfyun.cn/services/image（与 TTS/TTI 常为同一应用）
# 三者任一缺失 → 自动降级为本地占位产物（degraded=true），无 apikey 也能跑通验收。
# 文生图 endpoint 可覆盖（默认讯飞星火 TTI）；视频合成需容器内安装 ffmpeg。
PYT_SPARK_IMAGE_URL=https://spark-api.cn-huabei-1.xf-yun.com/v2.1/tti
# 看图答疑（图片理解，WebSocket）：endpoint 与 domain 可覆盖（默认 v2.1/image + imagev3）。
# 凭据缺失时导师答疑自动回退纯文本，不阻塞链路。
PYT_SPARK_IMAGE_UNDERSTANDING_URL=wss://spark-api.cn-huabei-1.xf-yun.com/v2.1/image
PYT_SPARK_IMAGE_UNDERSTANDING_DOMAIN=imagev3
# 多模态产物落盘目录（容器内路径；不入 git，可重生）
PYT_MEDIA_GENERATED_DIR=./data/course-pack-43/generated-media

# ── 讯飞访问代理（关键踩坑：fake-ip DNS 环境必配）──────────────────────────
# 若本机/宿主网络用 fake-ip DNS（如 Clash 把讯飞域名解析到 198.18.x.x），Java HttpClient
# 默认不读 HTTPS_PROXY，会导致文生图(TTI)/语音合成(TTS) connect timeout 而恒降级为占位。
# - 全 Docker（compose）：容器经 host.docker.internal 访问宿主代理，端口默认 7892。
#   直连网络无需代理时，设 PYT_XFYUN_PROXY_PORT 为空以退化为直连。
PYT_XFYUN_PROXY_HOST=host.docker.internal
PYT_XFYUN_PROXY_PORT=7892
# - 本机开发（./dev.sh）：用 PYT_XFYUN_PROXY（含 http:// 前缀）；留空回退 PYT_BILI_PROXY。
PYT_XFYUN_PROXY=http://127.0.0.1:7892

# 视频合成需 ffmpeg：compose 后端镜像已内置；./dev.sh 本机需自备
# （sudo apt install ffmpeg，或无 root 时 pip install imageio-ffmpeg 后软链进 PATH）。

# B站「关键时间点」官方 AI 总结需登录态（get_ai_conclusion 未登录返回 -101）。
# 不配则只给视频概述、不给时间点（符合「拿不到不编造」红线）。配置后可拿真实时间点。
# 获取：浏览器登录 B站 → F12 → Application → Cookies → 复制 SESSDATA 值。
PYT_BILI_SESSDATA=
