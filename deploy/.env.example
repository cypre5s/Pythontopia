# Pythontopia Docker Compose 环境变量样板。
# 用法：cp .env.example .env 并按需填入真实值，.env 不入 git。

# Postgres
PYT_DB_USERNAME=pytopia
PYT_DB_PASSWORD=pytopia_dev_password

# Backend
PYT_JWT_SECRET=replace-with-local-secret-at-least-32-chars
PYT_TEACHER_INVITE_CODE=pytopia-teacher

# RAG
PYT_RAG_ADMIN_TOKEN=pytopia-rag-admin
PYT_RAG_EMBEDDER=hash

# Graph LLM Provider 切换
# 可选值: dryrun（默认，本地无 LLM）、openai_compat、spark
PYT_LLM_PROVIDER=dryrun

# 当 PYT_LLM_PROVIDER=openai_compat 时填写
PYT_OPENAI_BASE_URL=
PYT_OPENAI_API_KEY=
PYT_OPENAI_MODEL=

# 当 PYT_LLM_PROVIDER=spark 时填写（演示主链路）
PYT_SPARK_APP_ID=
PYT_SPARK_API_KEY=
PYT_SPARK_API_SECRET=
PYT_SPARK_MODEL_ID=
