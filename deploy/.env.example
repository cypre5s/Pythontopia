# Copy to deploy/.env. Generate separate random secrets; never reuse main's database.
REBORN_DB_PASSWORD=
REBORN_API_PORT=18081
REBORN_WEB_PORT=15174
REBORN_TIME_ZONE=Asia/Shanghai
# 私有课程交换目录在宿主上的位置（挂载到容器 /app/data/course），默认 ../data/course。
REBORN_COURSE_EXCHANGE_DIR=../data/course
# First startup only: no public default account. Password: 12–200 characters.
# Existing administrator credentials are never overwritten on restart.
REBORN_ADMIN_STUDENT_ID=
REBORN_ADMIN_PASSWORD=
REBORN_ADMIN_NAME=管理员
# Optional, backend only. Missing AI/Judge0 is explicitly unavailable.
REBORN_AI_API_KEY=
REBORN_AI_BASE_URL=
REBORN_AI_MODEL=
# Authoring model for course content (per-page narration). Separate from the student
# assistant so quotas and logs stay apart; missing key makes narration unavailable.
# effort: none disables the thinking pass (measured 2-3s per page instead of 15-55s).
REBORN_AUTHORING_AI_API_KEY=
REBORN_AUTHORING_AI_BASE_URL=
REBORN_AUTHORING_AI_MODEL=
REBORN_AUTHORING_AI_VISION_MODEL=
REBORN_AUTHORING_AI_EFFORT=
REBORN_AUTHORING_AI_MAX_TOKENS=
REBORN_AUTHORING_AI_TIMEOUT_SECONDS=
REBORN_AUTHORING_AI_DAILY_PAGES=
# 学生“就这页提问”的每日上限，留空用默认 20。
REBORN_NARRATION_ASK_DAILY=
# 语音合成：留空 base_url 则只有文字讲解。
# protocol: deepseek = POST /v1/tools/tts（当前默认）；openai = 任何兼容 /v1/audio/speech 的云服务。
# DeepSeek 只有 stella（女声）/tide（男声）两个音色，只支持 wav/pcm，不支持调语速；
# format 要与真实引擎返回的一致，代码会把流式 wav 的 0xFFFFFFFF 长度改写为实际值，
# pcm 会自动包成 wav 容器（24kHz/16bit/单声道）。
REBORN_TTS_PROTOCOL=
REBORN_TTS_BASE_URL=
REBORN_TTS_API_KEY=
REBORN_TTS_MODEL=
REBORN_TTS_VOICE=
REBORN_TTS_FORMAT=
REBORN_TTS_SPEED=
REBORN_TTS_TIMEOUT_SECONDS=
# 引擎产出 wav/pcm 时转 mp3 再存（镜像里用 lame）。off 关闭；码率默认 96k。
REBORN_TTS_TRANSCODE=
REBORN_TTS_MP3_BITRATE=
REBORN_JUDGE0_URL=
REBORN_JUDGE0_AUTH_TOKEN=
# 存储：local（默认，用私有卷）或 s3。用 s3 必须同时填写三项 S3 配置，否则 API 拒绝启动并给出明确报错。
REBORN_STORAGE=local
REBORN_S3_ENDPOINT=
REBORN_S3_BUCKET=
REBORN_S3_PREFIX=reborn/
# 生产环境保持为空。开发工具要求 REBORN_DEV_TOOLS=1 且 REBORN_ENV=development。
REBORN_DEV_TOOLS=
# Optional isolated PPT converter: set a random >=24-character private token,
# URL=http://converter:8090, then start compose with --profile documents.
REBORN_CONVERTER_URL=
REBORN_CONVERTER_TOKEN=
