# Pythontopia Docker Compose 环境变量样板。
# 用法：cp .env.example .env 并按需填入真实值，.env 不入 git。

# Postgres
PYT_DB_USERNAME=pytopia
PYT_DB_PASSWORD=pytopia_dev_password

# Backend
PYT_JWT_SECRET=replace-with-local-secret-at-least-32-chars
PYT_TEACHER_INVITE_CODE=pytopia-teacher

# RAG
PYT_RAG_ADMIN_TOKEN=pytopia-rag-admin
PYT_RAG_EMBEDDER=hash

# Graph LLM Provider 切换
# 可选值: dryrun（默认，本地无 LLM）、openai_compat、spark
PYT_LLM_PROVIDER=dryrun

# 当 PYT_LLM_PROVIDER=openai_compat 时填写
PYT_OPENAI_BASE_URL=
PYT_OPENAI_API_KEY=
PYT_OPENAI_MODEL=

# 当 PYT_LLM_PROVIDER=spark 时填写（演示主链路）
PYT_SPARK_APP_ID=
PYT_SPARK_API_KEY=
PYT_SPARK_API_SECRET=
PYT_SPARK_MODEL_ID=

# 多模态生成（文生图 / 合成短视频 / TTS / 理解图片）—— 复用上面同一套讯飞 PYT_SPARK_* 凭据。
# 理解图片控制台：https://console.xfyun.cn/services/image（与 TTS/TTI 常为同一应用）
# 三者任一缺失 → 自动降级为本地占位产物（degraded=true），无 apikey 也能跑通验收。
# 文生图 endpoint 可覆盖（默认讯飞星火 TTI）；视频合成需容器内安装 ffmpeg。
PYT_SPARK_IMAGE_URL=https://spark-api.cn-huabei-1.xf-yun.com/v2.1/tti
# 看图答疑（图片理解，WebSocket）：endpoint 与 domain 可覆盖（默认 v2.1/image + imagev3）。
# 凭据缺失时导师答疑自动回退纯文本，不阻塞链路。
PYT_SPARK_IMAGE_UNDERSTANDING_URL=wss://spark-api.cn-huabei-1.xf-yun.com/v2.1/image
PYT_SPARK_IMAGE_UNDERSTANDING_DOMAIN=imagev3
# 多模态产物落盘目录（容器内路径；不入 git，可重生）
PYT_MEDIA_GENERATED_DIR=./data/course-pack-43/generated-media
