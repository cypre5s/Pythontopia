{
  "npcKey": "student_late_starter",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "{{playerName}}！我前八周都在打游戏，现在每天三道题，能赶上吗？",
      "conditions": [],
      "choices": [
        { "label": "能，先把前置 KC 补起来", "nextNodeId": "catch_up_plan" },
        { "label": "你怎么突然开窍？", "nextNodeId": "wake_up" },
        { "label": "聊聊你的进度", "nextNodeId": "progress_compare" },
        { "label": "加油", "nextNodeId": null }
      ]
    },
    "catch_up_plan": {
      "id": "catch_up_plan",
      "text": "我现在的方案：早上看课件 30 页，下午农场浇两块 KC，晚上训练场两道题。馆长 Doc 帮我画了表，你要看吗？",
      "conditions": [],
      "choices": [
        { "label": "我也想要那张表", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "ask_librarian_plan" }, { "type": "friendship", "delta": 2 }] }
      ]
    },
    "wake_up": {
      "id": "wake_up",
      "text": "期中那天我看了我的画像，8 维全是橙黄。Sage 跟我说一句：现在就是最早的时刻。然后我就开始了。",
      "conditions": [],
      "choices": [
        { "label": "有道理", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 2 }, { "type": "set_flag", "flagKey": "late_start_inspired" }] }
      ]
    },
    "progress_compare": {
      "id": "progress_compare",
      "text": "{{profileAdaptive:我现在掌握度 {{stats.peerLateStarterMastery}}，比你低一点，但我决定追到你前面，别催我。 | 我现在掌握度 {{stats.peerLateStarterMastery}}，你比我高 {{stats.masteryDeltaVsLateStarter}}，你别飘。}}",
      "conditions": [],
      "choices": [
        { "label": "互相督促", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "month_burn": {
      "id": "month_burn",
      "text": "本月我冲了 {{stats.peerLateStarterMonthExercises}} 道。Sage 让我注意别 burn out，你别学我这种打法，你按你节奏。",
      "conditions": [{ "type": "first_time_this_week", "key": "month_burn" }],
      "choices": [
        { "label": "谢谢提醒", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:这玩意我正缺，谢！ | 谢谢，今晚续命。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "应该的", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，期末我冲到全班前 30%。我把我那张追赶日历送你，哪天起步都来得及。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "受用", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "catchup_calendar" }, { "type": "set_flag", "flagKey": "student_late_starter_max_friend" }] }
      ]
    }
  }
}
