{
  "npcKey": "student_top",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "{{playerName}}，我做完那 39 题了，最近在刷外校期末。要交流解法吗？",
      "conditions": [],
      "choices": [
        { "label": "你怎么做到的", "nextNodeId": "how_top" },
        { "label": "给我推荐一道难题", "nextNodeId": "challenge" },
        { "label": "你不会无聊吗", "nextNodeId": "boredom" },
        { "label": "下次聊", "nextNodeId": null }
      ]
    },
    "how_top": {
      "id": "how_top",
      "text": "我每解锁一个 KC 都会写一段总结，发到镇上公告板。回头你翻一翻 — 比我跟你讲一遍快多了。",
      "conditions": [],
      "choices": [
        { "label": "我去看公告板", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "read_top_notes" }, { "type": "friendship", "delta": 2 }] }
      ]
    },
    "challenge": {
      "id": "challenge",
      "text": "{{profileAdaptive:你掌握度够了，试 #{{stats.challengeProblemNo}}，再做完我们对一下答案。 | 你先把基础 KC 浇到 70% 再来 — 太早挑战难题会自信受挫。}}",
      "conditions": [],
      "choices": [
        { "label": "上", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "training_challenge" }, { "type": "friendship", "delta": 2 }] }
      ]
    },
    "boredom": {
      "id": "boredom",
      "text": "会无聊。所以我跟工长聊了，下学期想做小项目 — Python 写个像 Pythontopia 一样的小镇。",
      "conditions": [],
      "choices": [
        { "label": "我能加入吗", "nextNodeId": "invite_join", "effects": [{ "type": "friendship", "delta": 3 }] },
        { "label": "祝你做出来", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "invite_join": {
      "id": "invite_join",
      "text": "当然，需要新人。我帮你向工长报名 — 这周末工坊外见。",
      "conditions": [],
      "choices": [
        { "label": "等你", "nextNodeId": null, "effects": [{ "type": "set_flag", "flagKey": "side_project_invited" }, { "type": "quest_recommend", "questKey": "side_project_signup" }] }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:不错的品味。 | 收下，谢谢。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "应该的", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，谢谢你这学期没把我当怪人。给你我那本 \"算法直觉\" 笔记 — 比 39 题更厚。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "我会读完", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "algo_intuition_notebook" }, { "type": "set_flag", "flagKey": "student_top_max_friend" }] }
      ]
