{
  "npcKey": "farmer_kc",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "嚯，{{playerName}}回来啦。地里这些苗子都在等你浇水。",
      "conditions": [],
      "choices": [
        { "label": "我有哪些地可以种？", "nextNodeId": "available_kcs" },
        { "label": "今天该浇哪块地？", "nextNodeId": "today_focus" },
        { "label": "枯萎是怎么回事？", "nextNodeId": "wilt_explain" },
        { "label": "再聊", "nextNodeId": null }
      ]
    },
    "available_kcs": {
      "id": "available_kcs",
      "text": "你解锁了 {{stats.kcUnlocked}} 块地，剩下的得先通过前置 KC 才能开垦。当前可种：{{stats.kcUnlockedListShort}}。",
      "conditions": [],
      "choices": [
        { "label": "我去浇第一块", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }, { "type": "quest_recommend", "questKey": "field_water_today" }] },
        { "label": "下次再说", "nextNodeId": null }
      ]
    },
    "today_focus": {
      "id": "today_focus",
      "text": "{{profileAdaptive:你这周浇水节奏稳，今天可以尝试解锁新地块 \"{{stats.nextKcName}}\"。 | 你最近浇水有点少，先把 \"{{stats.lowestMasteryKcName}}\" 浇够，再开新地块。}}",
      "conditions": [],
      "choices": [
        { "label": "听田老的", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 2 }, { "type": "quest_recommend", "questKey": "field_today_focus" }] }
      ]
    },
    "wilt_explain": {
      "id": "wilt_explain",
      "text": "苗子枯萎，是你那块 KC 太久没复习了。地里写着 \"{{stats.wiltedKcName}}\" — 去再做两道题，叶子就回来。",
      "conditions": [{ "type": "has_wilted_kc" }],
      "choices": [
        { "label": "马上去救", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "recover_wilted_kc" }, { "type": "friendship", "delta": 1 }] }
      ]
    },
    "harvest_ready": {
      "id": "harvest_ready",
      "text": "\"{{stats.harvestKcName}}\" 这块地已经熟了，掌握度过 80%。来，收一筐 KC 票券。",
      "conditions": [{ "type": "has_harvest_ready" }],
      "choices": [
        { "label": "收成", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "kc_ticket" }, { "type": "friendship", "delta": 2 }, { "type": "set_flag", "flagKey": "farmer_kc_harvest_today" }] }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:好家伙，这个我正缺！地里的孩子今天有福了。 | 谢了，揣兜里。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "应该的", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，你是这地里最勤快的孩子。把这把传家洒水壶给你 — 它能让 KC 多吸两成阳光。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "我会好好用", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "heirloom_watering_can" }, { "type": "set_flag", "flagKey": "farmer_kc_max_friend" }] }
      ]
    }
  }
}
