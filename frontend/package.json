{
  "name": "pythontopia-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:npc": "node scripts/sync-npc-data.mjs",
    "sync:course43": "node scripts/sync-course43.mjs",
    "predev": "node scripts/sync-npc-data.mjs --quiet && node scripts/sync-course43.mjs --quiet",
    "dev": "vite",
    "prebuild": "node scripts/sync-npc-data.mjs --quiet && node scripts/sync-course43.mjs --quiet",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/howler": "^2.2.13",
    "axios": "1.7.9",
    "gsap": "3.13",
    "howler": "^2.2.4",
    "phaser": "3.87.0",
    "pinia": "2.3.0",
    "tone": "^15.1.22",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitejs/plugin-vue": "5.1.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.32.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
