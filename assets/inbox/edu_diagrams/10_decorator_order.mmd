%% Pythontopia CC0 - 用途：演示装饰器堆叠时"由近及远"的包装顺序与"由外到内"的执行顺序
%% 关联 KC：PY43-KC-012（基础函数）、PY43-KC-060（函数变量的作用域）
%% 备注：装饰器在课程包 packId=43 中作为通识扩展呈现
%% 示例代码：
%%   @log
%%   @auth
%%   @cache
%%   def view(req): ...
%% 等价于：view = log(auth(cache(view)))

flowchart LR
    subgraph WRAP["① 装饰阶段（自下而上包装）"]
        direction TB
        ORIG["原始函数 view"]
        W1["cache(view) → view'"]
        W2["auth(view') → view''"]
        W3["log(view'') → view'''"]
        ORIG --> W1 --> W2 --> W3
    end

    subgraph CALL["② 调用阶段（从最外层 log 开始向内）"]
        direction TB
        IN(["view'''(req) 被调用"])
        L_IN["log 包装：打印请求日志"]
        A_IN["auth 包装：校验权限"]
        C_IN["cache 包装：查缓存"]
        REAL["真正的 view(req)"]
        C_OUT["cache 包装：写入缓存"]
        A_OUT["auth 包装：审计返回"]
        L_OUT["log 包装：打印响应耗时"]
        OUT(["返回结果"])

        IN --> L_IN --> A_IN --> C_IN --> REAL --> C_OUT --> A_OUT --> L_OUT --> OUT
    end

    W3 -.等价于.-> IN

    NOTE["核心口诀：<br/>装饰时：靠近函数定义的装饰器先包<br/>调用时：最外层装饰器先跑（先入后出，洋葱模型）<br/>等价表达式：log(auth(cache(view)))"]
    CALL --- NOTE

    classDef wrap fill:#cce5ff,stroke:#004085,color:#222
    classDef in fill:#fff3cd,stroke:#856404,color:#222
    classDef core fill:#d4edda,stroke:#155724,color:#222
    classDef note fill:#f8d7da,stroke:#721c24,color:#222
    class ORIG,W1,W2,W3 wrap
    class L_IN,A_IN,C_IN,C_OUT,A_OUT,L_OUT in
    class REAL,IN,OUT core
    class NOTE note
