%% Pythontopia CC0 - 用途：dict 哈希查找流程 - 对应 KC：PY43-KC-042 字典基本操作
flowchart TD
    Start(["d[key] 查找"]) --> Hash["hash(key) -> int"]
    Hash --> Mod["index = hash mod table_size"]
    Mod --> Read["读 buckets[index]"]
    Read --> Empty{"bucket 是空？"}
    Empty -- "是" --> Miss["抛 KeyError"]
    Empty -- "否" --> Compare{"bucket.key == key？（按值比较）"}
    Compare -- "是（命中）" --> Return["返回 bucket.value"]
    Compare -- "否（哈希冲突）" --> Probe["开放寻址：探测下一个槽"]
    Probe --> Read

    Note1["Key 必须是 hashable<br/>不可变类型才能做 key"]
    Hash -.- Note1

    Note2["不同 key 但 hash 相同<br/>= 哈希冲突，靠 == 区分"]
    Compare -.- Note2

    classDef start fill:#bbdefb,stroke:#1565c0,color:#0d47a1,stroke-width:1px;
    classDef ok fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20,stroke-width:1px;
    classDef err fill:#ffcdd2,stroke:#c62828,color:#b71c1c,stroke-width:1px;
    classDef note fill:#fff9c4,stroke:#f9a825,color:#5d4037,stroke-width:1px;
    class Start,Return ok;
    class Miss err;
    class Note1,Note2 note;
