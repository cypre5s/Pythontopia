%% Pythontopia CC0 - 用途：list 内存模型（引用 / 浅拷贝 / 深拷贝）- 对应 KC：PY43-KC-040 列表基本操作
flowchart LR
    subgraph Stack["Python 栈：变量名"]
        A["a"]
        B["b = a"]
        C["c = a.copy()"]
        D["d = copy.deepcopy(a)"]
    end

    subgraph Heap["Python 堆：对象"]
        L1["列表对象 #1: [1, 2, [9, 9]]"]
        L2["列表对象 #2: [1, 2, ?]"]
        L3["列表对象 #3: [1, 2, ?]"]
        Inner1["内部列表 #4: [9, 9]"]
        Inner2["内部列表 #5: [9, 9]"]
    end

    A -- "id 指向" --> L1
    B -- "id 指向（同对象）" --> L1
    C -- "新列表，但内层共享" --> L2
    L2 -- "内层引用" --> Inner1
    L1 -- "内层引用" --> Inner1
    D -- "全新对象 + 全新内层" --> L3
    L3 -- "新内层" --> Inner2

    classDef stack fill:#fde2c4,stroke:#b06600,color:#3d2200,stroke-width:1px;
    classDef heap fill:#c8e6c9,stroke:#1b5e20,color:#1b5e20,stroke-width:1px;
    class A,B,C,D stack;
    class L1,L2,L3,Inner1,Inner2 heap;
