%% Pythontopia CC0 - 用途：递归调用树（以 factorial(4) 为例）- 对应 KC：PY43-KC-061 函数递归
flowchart TD
    F4["factorial(4)"] --> F3["factorial(3)"]
    F3 --> F2["factorial(2)"]
    F2 --> F1["factorial(1)"]
    F1 --> Base["1（基线 / base case）"]

    Base -. "返回 1" .-> F1
    F1 -. "返回 1 * 1 = 1" .-> F2
    F2 -. "返回 2 * 1 = 2" .-> F3
    F3 -. "返回 3 * 2 = 6" .-> F4
    F4 -. "返回 4 * 6 = 24" .-> Out(["最终结果 24"])

    Risk["❗ 递归必须有 base case<br/>否则 RecursionError（默认深度 1000）"]
    F1 -.- Risk

    classDef call fill:#bbdefb,stroke:#1565c0;
    classDef base fill:#c8e6c9,stroke:#2e7d32;
    classDef warn fill:#ffe082,stroke:#f57f17;
    class F4,F3,F2,F1 call;
    class Base,Out base;
    class Risk warn;
