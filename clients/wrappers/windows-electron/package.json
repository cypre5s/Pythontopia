{
  "name": "pythontopia-desktop",
  "version": "1.0.0",
  "description": "Pythontopia 桌面端（Electron 外壳，加载云端像素学习小镇，后端指向阿里云 ECS）",
  "main": "main.js",
  "author": "Pythontopia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/make-icon.mjs && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.pythontopia.desktop",
    "productName": "Pythontopia",
    "copyright": "Copyright (c) 2026 Pythontopia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "pythontopia-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pythontopia",
      "artifactName": "pythontopia-windows.${ext}"
    }
  }
}
