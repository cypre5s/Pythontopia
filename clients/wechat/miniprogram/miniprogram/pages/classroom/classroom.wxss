.classroom__join {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.classroom__code {
  flex: 1;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  font-size: 32rpx;
}

.quest__desc {
  margin: 10rpx 0;
  font-size: 26rpx;
  color: var(--ink-soft);
}

.quest__actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
