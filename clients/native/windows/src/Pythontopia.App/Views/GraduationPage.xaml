<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.GraduationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <InfoBar
            VerticalAlignment="Top"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            IsClosable="False"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Ceremony -->
        <Border
            Style="{StaticResource PytCardBorderStyle}"
            Padding="36,32"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.Graduated, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <TextBlock Text="🎓" FontSize="52" HorizontalAlignment="Center" />
                <TextBlock Text="Pythontopia 毕业典礼" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.CueText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="总星数" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.StarsText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="通关章节" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ChaptersText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="达标知识点" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.KcsText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="获得：毕业袍 · 称号「Pythontopia 校友」" FontSize="13" HorizontalAlignment="Center" Opacity="0.85" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Content="回到小镇" Style="{ThemeResource AccentButtonStyle}" Click="OnGoTown" />
                    <Button Content="回顾我的学习档案" Click="OnGoProfileRoom" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Locked / not yet graduated -->
        <Border
            Style="{StaticResource PytCardBorderStyle}"
            Padding="32,28"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.ShowLocked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="44" HorizontalAlignment="Center" />
                <TextBlock Text="尚未毕业" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.LockedText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="总星数" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.StarsText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="通关章节" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ChaptersText, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <Button Content="去主线闯关" Style="{ThemeResource AccentButtonStyle}" Click="OnGoMainline" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
