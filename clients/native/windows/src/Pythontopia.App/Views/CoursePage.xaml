<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.CoursePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="课程 · Python语言基础" FontSize="24" FontWeight="Bold" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.PackSummary, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="章节" FontWeight="SemiBold" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="知识点" FontWeight="SemiBold" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Kcs, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedKc, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding KcName}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.6">
                                    <TextBlock Text="{Binding KcCode}" FontSize="11" />
                                    <TextBlock Text="{Binding Difficulty}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="2" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="课件页" FontWeight="SemiBold" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding PageNo}" Opacity="0.6" />
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <ScrollViewer Grid.Column="3" Padding="8,0,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.SelectedPage.Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                    <Border Style="{StaticResource PytCardBorderStyle}" Padding="8">
                        <Image Source="{x:Bind ViewModel.PageImage, Mode=OneWay}" Stretch="Uniform" HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.SelectedPage.Excerpt, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
