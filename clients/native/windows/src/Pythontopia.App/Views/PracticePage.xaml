<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.PracticePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="24" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="知识点" FontWeight="SemiBold" />
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Kcs, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedKc, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding KcName}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding KcCode}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="题目" FontWeight="SemiBold" />
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Problems, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedProblem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Difficulty}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" Width="20" Height="20" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Detail.StatementMarkdown, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="样例"
                        FontWeight="SemiBold"
                        Visibility="{x:Bind ViewModel.SamplesText, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    <TextBox
                        Text="{x:Bind ViewModel.SamplesText, Mode=OneWay}"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.SamplesText, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <TextBox
                Grid.Row="2"
                Header="代码（Python）"
                Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                FontFamily="Consolas"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" />

            <StackPanel Grid.Row="3" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button
                        Content="提交判题"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SubmitCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{x:Bind ViewModel.SubmitStatus, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>
                <Border
                    Padding="10,6"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.Verdict, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Verdict, Mode=OneWay}" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.JudgeSummary, Mode=OneWay}" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
