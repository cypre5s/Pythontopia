<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="新手引导" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="欢迎来到 Pythontopia 像素学习小镇。下面是核心学习闭环与各功能入口。" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource PytCardBorderStyle}" Padding="16" Background="{StaticResource BrandHeaderBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="学习闭环：看 → 学 → 练 → 测 → 复盘" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            Text="在「主线地图」按章节闯关；每关先看课程视频、读课件，再练例题，达标后参加「章节测验」，最后到「复盘大厅」巩固。"
                            Foreground="White"
                            Opacity="0.9"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="看 · 学" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <TextBlock Text="· 主线地图 / 学习路径：按个性化路径推进章节关卡。" TextWrapping="Wrap" />
                        <TextBlock Text="· 课程 / 例题 / 课件库：看章节课件页、读 PDF、学例题代码。" TextWrapping="Wrap" />
                        <TextBlock Text="· B 站精选：按关键词找外部讲解视频。" TextWrapping="Wrap" />
                        <TextBlock Text="· 百晓工坊：一句话答疑 / 生成讲义等学习资源。" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="练 · 测" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <TextBlock Text="· 训练场：提交代码，服务端真实判题。" TextWrapping="Wrap" />
                        <TextBlock Text="· 章节测验：出卷 → 答题 → 判分。" TextWrapping="Wrap" />
                        <TextBlock Text="· Boss 副本 / 无尽模式：闯关式编程挑战。" TextWrapping="Wrap" />
                        <TextBlock Text="· 费曼学弟：把知识点讲给学弟听，检验理解。" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="复盘 · 成长" FontWeight="SemiBold" />
                    </Expander.Header>
                    <StackPanel Spacing="4">
                        <TextBlock Text="· Bug 矿洞：把错题/遗忘点逐层解锁、重做巩固。" TextWrapping="Wrap" />
                        <TextBlock Text="· 复盘大厅 / 学情洞察：看本周记忆流、洞察与风险预测。" TextWrapping="Wrap" />
                        <TextBlock Text="· 画像 / 技能：查看 8 维画像、掌握度与技能树。" TextWrapping="Wrap" />
                        <TextBlock Text="· 小镇 / NPC / 日历 / 存档：在像素小镇里与 NPC 互动、推进存档。" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
