<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.MainlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="MainlineRoot" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="主线地图" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Border CornerRadius="10" Padding="10,2" Background="{StaticResource BrandHeaderBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.TotalStarsText, Mode=OneWay}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                </Border>
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <TextBlock
                Text="看课 → 读课件 → 练例题 的章节闯关进度，数据来自后端 /api/mainline/overview。"
                Opacity="0.7"
                FontSize="12"
                TextWrapping="Wrap" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Style="{StaticResource PytCardBorderStyle}"
            Padding="16"
            Visibility="{x:Bind ViewModel.ShowStageDetail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.StageDetailTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Content="记录观看 +1 分钟" Command="{x:Bind ViewModel.ReportVideoCommand}" />
                    <Button Content="标记课件已读" Command="{x:Bind ViewModel.MarkPagesReadCommand}" />
                    <Button Content="关闭" Command="{x:Bind ViewModel.CloseStageCommand}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.StageDetailSummary, Mode=OneWay}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="视频" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StageVideos, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="例题" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StageExamples, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="练习" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StageQuestions, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,8"
                            IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Progress}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Status}"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Opacity="0.85" />
                                            <Button
                                                Grid.Column="2"
                                                Content="详情"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.OpenStageCommand, ElementName=MainlineRoot}"
                                                CommandParameter="{Binding Id}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
