<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.ProfileRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="学习档案室" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            IsClosable="False"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="14" MaxWidth="900">

                <!-- ProfileAgent 画像访谈 -->
                <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="画像访谈（ProfileAgent）" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button
                                Content="开始访谈"
                                Command="{x:Bind ViewModel.StartInterviewCommand}"
                                IsEnabled="{x:Bind ViewModel.InterviewBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.InterviewBusy, Mode=OneWay}" Width="18" Height="18" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.InterviewStatus, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.InterviewMessages, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                        <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="12" MinWidth="56" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.InterviewActive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBox
                                PlaceholderText="输入你的回答…"
                                Width="560"
                                Text="{x:Bind ViewModel.InterviewInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Content="发送"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SendInterviewCommand}"
                                IsEnabled="{x:Bind ViewModel.InterviewBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Profile narrative -->
                <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="学习画像" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Major, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Narrative, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.NoProfileText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Opacity="0.7"
                            Visibility="{x:Bind ViewModel.NoProfileText, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 8 dimensions -->
                <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="八维画像" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Dimensions, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Digital twin weekly -->
                <Border
                    Style="{StaticResource PytCardBorderStyle}"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.HasWeekly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="本周数字孪生周报" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.WeekRange, Mode=OneWay}" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{x:Bind ViewModel.WeeklySummary, Mode=OneWay}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Highlights, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Agent memory notebook -->
                <Border
                    Style="{StaticResource PytCardBorderStyle}"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.HasMemory, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Agent 记忆笔记本" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Memory, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4" Spacing="2">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding When}" FontSize="11" Opacity="0.5" />
                                            <TextBlock Text="{Binding Kcs}" FontSize="11" Opacity="0.5" Visibility="{Binding HasKcs, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
