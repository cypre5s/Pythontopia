<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.BossPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Boss 副本" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <ComboBox Header="章节" MinWidth="90" ItemsSource="{x:Bind ViewModel.ChapterOptions}" SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}" />
                <ComboBox Header="阶段" MinWidth="90" ItemsSource="{x:Bind ViewModel.StageOptions}" SelectedItem="{x:Bind ViewModel.SelectedStage, Mode=TwoWay}" />
                <Button
                    Content="召唤 Boss 题"
                    VerticalAlignment="Bottom"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SummonCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" VerticalAlignment="Bottom" />
            </StackPanel>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource PytCardBorderStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Statement, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Hints, Mode=OneWay}" Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Hints, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                            <TextBlock Text="{x:Bind ViewModel.Sample, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Sample, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    Grid.Row="0"
                    Header="解答代码（Python）"
                    Text="{x:Bind ViewModel.Code, Mode=TwoWay}"
                    FontFamily="Consolas"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    IsEnabled="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <Button
                    Grid.Row="1"
                    Content="提交挑战"
                    HorizontalAlignment="Left"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    IsEnabled="{x:Bind ViewModel.HasProblem, Mode=OneWay}" />
                <Border
                    Grid.Row="2"
                    Style="{StaticResource PytCardBorderStyle}"
                    Padding="12"
                    Visibility="{x:Bind ViewModel.Result, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{x:Bind ViewModel.Result, Mode=OneWay}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
