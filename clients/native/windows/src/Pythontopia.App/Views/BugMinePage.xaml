<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.BugMinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="Bug 矿洞" FontSize="24" FontWeight="Bold" />
            <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- LIST VIEW (no open session) -->
        <Grid
            Grid.Row="1"
            ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="错题矿洞（未关闭会话）" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ErrorBook, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ProblemTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding KcCode}" FontSize="11" Opacity="0.6" />
                                    <TextBlock Text="{Binding RecommendationReason}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock FontSize="12" Opacity="0.7">
                                            <Run Text="衰减风险 " />
                                            <Run Text="{Binding DecayRisk, Converter={StaticResource Percent}}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.7">
                                            <Run Text="入矿优先级 " />
                                            <Run Text="{Binding MinePriority, Converter={StaticResource Percent}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Content="进入矿洞" Margin="0,4,0,0"
                                            Command="{Binding DataContext.OpenErrorCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="遗忘回声（FSRS 到期 · 建议复盘）" FontWeight="SemiBold" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Echoes, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ProblemTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding KcCode}" FontSize="11" Opacity="0.6" />
                                    <TextBlock Text="{Binding RecommendationReason}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock FontSize="12" Opacity="0.7">
                                            <Run Text="推荐 " />
                                            <Run Text="{Binding MinePriority, Converter={StaticResource Percent}}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.7">
                                            <Run Text="衰减风险 " />
                                            <Run Text="{Binding DecayRisk, Converter={StaticResource Percent}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Content="入矿复盘" Margin="0,4,0,0"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Command="{Binding DataContext.OpenEchoCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- SESSION DETAIL VIEW -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="12" Padding="0,0,12,0">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="← 返回列表" Command="{x:Bind ViewModel.BackToListCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.SessionSummary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.85" />
                </StackPanel>

                <TextBlock
                    Text="{x:Bind ViewModel.Session.ProfileGuidance, Mode=OneWay}"
                    TextWrapping="Wrap" Opacity="0.8" FontStyle="Italic"
                    Visibility="{x:Bind ViewModel.Session.ProfileGuidance, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />

                <Border Style="{StaticResource PytCardBorderStyle}" Padding="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.ProblemTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProblemStatement, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBox
                            Header="样例"
                            Text="{x:Bind ViewModel.SamplesText, Mode=OneWay}"
                            IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.SamplesText, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="深度分层" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.DepthSteps, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,6" Margin="0,2" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Layer}" FontWeight="Bold" Width="24" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="已解锁" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Unlocked, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="2" Text="未解锁" Opacity="0.5" VerticalAlignment="Center"
                                               Visibility="{Binding Unlocked, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="矿洞卡片（逐层解锁）" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" />
                                        <Button Content="解锁"
                                                Command="{Binding DataContext.RevealCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Revealed, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox
                    Header="修正代码（Python）"
                    Text="{Binding RetryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="160"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="原题重试提交" Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RetrySubmitCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    <Button Content="变式题提交"
                            Command="{x:Bind ViewModel.VariantSubmitCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Visibility="{x:Bind ViewModel.HasVariant, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="查看变式题题面"
                            Command="{x:Bind ViewModel.LoadVariantCommand}"
                            Visibility="{x:Bind ViewModel.HasVariant, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{x:Bind ViewModel.SubmitStatus, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>

                <Border Padding="10,6" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.Verdict, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Verdict, Mode=OneWay}" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.JudgeSummary, Mode=OneWay}" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PytCardBorderStyle}" Padding="12"
                        Visibility="{x:Bind ViewModel.VariantDetail, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.VariantDetail.Title, Mode=OneWay}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.VariantDetail.StatementMarkdown, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Button Content="标记已攻克" Command="{x:Bind ViewModel.CloseResolvedCommand}" />
                    <Button Content="放弃本矿洞" Command="{x:Bind ViewModel.CloseAbandonedCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
