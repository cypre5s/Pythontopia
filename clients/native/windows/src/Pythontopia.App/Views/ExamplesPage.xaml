<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.ExamplesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="例题库" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.Examples, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="0,4">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding KcCode}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.Selected.KcCode, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                    <Border Style="{StaticResource PytCardBorderStyle}" Padding="12">
                        <TextBox
                            Text="{x:Bind ViewModel.Selected.Code, Mode=OneWay}"
                            IsReadOnly="True"
                            FontFamily="Consolas"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            BorderThickness="0"
                            Background="Transparent" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.Selected.ExplanationMarkdown, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
