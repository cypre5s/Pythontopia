<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.BilibiliPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="B 站精选" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox
                    MinWidth="240"
                    PlaceholderText="搜索关键词（如 for 循环）"
                    Text="{x:Bind ViewModel.Keyword, Mode=TwoWay}" />
                <Button
                    Content="搜索"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PytCardBorderStyle}" Padding="14" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Meta}" FontSize="12" Opacity="0.6" />
                                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                                <HyperlinkButton Content="在浏览器打开" NavigateUri="{Binding Link}" Padding="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
