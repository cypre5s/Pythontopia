<Project>
  <!--
    Shared build settings for every project in the Pythontopia Windows solution.
    Pythontopia.Core (net8.0) and Pythontopia.Game (net8.0, DesktopGL) are
    cross-platform and build with the interop Windows dotnet.exe from WSL.
    Pythontopia.App (WinUI 3 / net8.0-windows10.0.19041.0) must be built on Windows.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Company>Pythontopia</Company>
    <Product>Pythontopia Desktop</Product>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>
</Project>
