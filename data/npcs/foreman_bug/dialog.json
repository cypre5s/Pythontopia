{
  "npcKey": "foreman_bug",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "新人来了？矿洞里全是你提交失败时掉下来的 Bug，挑一只下去打。",
      "conditions": [],
      "choices": [
        { "label": "上次失败的提交是什么？", "nextNodeId": "last_failed" },
        { "label": "矿洞规则？", "nextNodeId": "mine_rules" },
        { "label": "我没失败过", "nextNodeId": "no_failure_yet" },
        { "label": "下次见", "nextNodeId": null }
      ]
    },
    "last_failed": {
      "id": "last_failed",
      "text": "你最近一次失败在 \"{{stats.lastFailedProblemTitle}}\"，错的类型是 {{stats.lastFailedErrorType}}。矿洞 B{{stats.lastFailedMineLevel}} 层有它的影子，要下去吗？",
      "conditions": [{ "type": "has_failed_submission" }],
      "choices": [
        { "label": "下去打", "nextNodeId": null, "effects": [{ "type": "route", "route": "/bug-mine" }, { "type": "friendship", "delta": 2 }] },
        { "label": "我先看看课件", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "mine_rules": {
      "id": "mine_rules",
      "text": "三条规矩：一，下矿前看证据页；二，写代码，别瞎试；三，打掉 Bug 后必须写一句话错因 — 不然下次还掉。",
      "conditions": [],
      "choices": [
        { "label": "记住了", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }, { "type": "set_flag", "flagKey": "mine_rules_known" }] }
      ]
    },
    "no_failure_yet": {
      "id": "no_failure_yet",
      "text": "{{profileAdaptive:你提交记录干净，去训练场挑战题刷一两道，掉下来的 Bug 我替你存着。 | 还没失败？早晚的事。先去训练场练手，回头再来。}}",
      "conditions": [{ "type": "no_failed_submission" }],
      "choices": [
        { "label": "去训练场", "nextNodeId": null, "effects": [{ "type": "route", "route": "/training" }] }
      ]
    },
    "mine_boss_hint": {
      "id": "mine_boss_hint",
      "text": "B5 层那只 IndentationError 是新人之骨。你的画像分类 {{stats.profileType}} 多半在缩进上栽过，下次留意。",
      "conditions": [{ "type": "kc_mastered", "kcCode": "PY43-KC-019" }],
      "choices": [
        { "label": "学到了", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:不错，矿灯够亮。下次带你进深层。 | 收了。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "辛苦了", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，矿洞最深层只对我亲信开。以后遇到 IndentationError，按我教你的法子一层层排查，一个都跑不掉。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "我记下了", "nextNodeId": null, "effects": [{ "type": "set_flag", "flagKey": "foreman_bug_max_friend" }] }
      ]
    }
  }
}
