{
  "npcKey": "craftsman",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "嘿，{{playerName}}，工坊里少一双手。要不要在这里挂个名？",
      "conditions": [],
      "choices": [
        { "label": "工坊是做什么的？", "nextNodeId": "what_workshop" },
        { "label": "我能加入副项目吗？", "nextNodeId": "join_side" },
        { "label": "今天有什么工具？", "nextNodeId": "tool_shelf" },
        { "label": "我再看看", "nextNodeId": null }
      ]
    },
    "what_workshop": {
      "id": "what_workshop",
      "text": "学课程之外，咱在这里造小工具：自动批改脚本、小镇地图编辑器、像素画板。Python 学完哪一章，就能解锁一种小工具。",
      "conditions": [],
      "choices": [
        { "label": "有意思", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "join_side": {
      "id": "join_side",
      "text": "{{profileAdaptive:你掌握度够，欢迎你来 — 这周末小镇副本组要开第一次会。 | 你课程还没追完，先把第三章列表学完再来报名，别两头空。}}",
      "conditions": [],
      "choices": [
        { "label": "我来报名", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "side_project_signup" }, { "type": "friendship", "delta": 2 }, { "type": "set_flag", "flagKey": "side_project_signed" }] }
      ]
    },
    "tool_shelf": {
      "id": "tool_shelf",
      "text": "今天货架上有：自动跑判题的脚本模板、画像可视化模板、班级看板模板。挑一个？",
      "conditions": [],
      "choices": [
        { "label": "判题脚本模板", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "judge_script_template" }, { "type": "friendship", "delta": 1 }] },
        { "label": "画像可视化模板", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "profile_viz_template" }, { "type": "friendship", "delta": 1 }] },
        { "label": "下次再挑", "nextNodeId": null }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:好东西，正缺一把。 | 谢，挂工具墙上。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "应该的", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，你来工坊次数最多。给你一张终身贵宾凳贴 — 以后副项目你说算。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "谢工长", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "workshop_vip_seat" }, { "type": "set_flag", "flagKey": "craftsman_max_friend" }] }
      ]
    }
  }
}
