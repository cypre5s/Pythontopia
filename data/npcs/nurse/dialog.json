{
  "npcKey": "nurse",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "{{playerName}}，今天体力 {{stats.energyCurrent}}/{{stats.energyMax}}。要补一点吗？",
      "conditions": [],
      "choices": [
        { "label": "恢复体力", "nextNodeId": "restore" },
        { "label": "我没事", "nextNodeId": "fine" },
        { "label": "你看到拖延小迟了吗？", "nextNodeId": "gossip" },
        { "label": "保重", "nextNodeId": null }
      ]
    },
    "restore": {
      "id": "restore",
      "text": "{{profileAdaptive:坐下 5 分钟。我帮你把每日 Pyodide 调试上限刷新一次。 | 你刚刚连撕三道，先停 10 分钟，今天先到这。}}",
      "conditions": [],
      "choices": [
        { "label": "谢谢", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "energy_token" }, { "type": "friendship", "delta": 2 }, { "type": "set_flag", "flagKey": "nurse_visited_today" }] }
      ]
    },
    "fine": {
      "id": "fine",
      "text": "嘴硬。我看你眼袋都黑了。坐下 — 给你一杯洋甘菊。",
      "conditions": [],
      "choices": [
        { "label": "好吧", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "chamomile_tea" }, { "type": "friendship", "delta": 1 }] }
      ]
    },
    "gossip": {
      "id": "gossip",
      "text": "拖延小迟今早被我赶去农场了，他自己说今晚不熬夜。咱看他能不能。",
      "conditions": [],
      "choices": [
        { "label": "听起来不靠谱", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "burnout_warn": {
      "id": "burnout_warn",
      "text": "你这周做了 {{stats.exercisesThisWeek}} 道题，已经超出我推荐上限。今晚强制下线，明天再来。",
      "conditions": [{ "type": "exercise_burnout_risk" }],
      "choices": [
        { "label": "听医嘱", "nextNodeId": null, "effects": [{ "type": "set_flag", "flagKey": "burnout_warned" }, { "type": "friendship", "delta": 2 }] }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:专业人士见专业人士。 | 谢，备药柜。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "客气", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，常来啊。这枚医务徽章送你 — 你也是镇上一个安心存在。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "谢谢", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "nurse_badge" }, { "type": "set_flag", "flagKey": "nurse_max_friend" }] }
      ]
    }
  }
}
