{
  "npcKey": "student_diligent",
  "rootNodeId": "greet",
  "nodes": {
    "greet": {
      "id": "greet",
      "text": "嗨，{{playerName}}！今天我已经做完两道题啦，你呢？",
      "conditions": [],
      "choices": [
        { "label": "你怎么坚持下来的？", "nextNodeId": "method" },
        { "label": "我们一起做一道题吧", "nextNodeId": "co_study" },
        { "label": "你这周进度多少？", "nextNodeId": "peer_progress" },
        { "label": "我先走了", "nextNodeId": null }
      ]
    },
    "method": {
      "id": "method",
      "text": "其实没诀窍，就是每天定 25 分钟番茄钟，先做一道题再看一段课件。复盘师 Sage 说过，节奏比强度重要。",
      "conditions": [],
      "choices": [
        { "label": "我试试", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 2 }, { "type": "set_flag", "flagKey": "pomodoro_known" }] }
      ]
    },
    "co_study": {
      "id": "co_study",
      "text": "{{profileAdaptive:那来题 #{{stats.recommendProblemNo}}，你写主函数我写测试。 | 推荐你先做 #{{stats.entryProblemNo}}，我陪你写。}}",
      "conditions": [],
      "choices": [
        { "label": "走吧", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "co_solve_today" }, { "type": "friendship", "delta": 2 }] }
      ]
    },
    "peer_progress": {
      "id": "peer_progress",
      "text": "我这周做了 {{stats.peerDiligentExercisesWeek}} 道，掌握度均值 {{stats.peerDiligentMastery}}。你做了 {{stats.exercisesThisWeek}} 道，差距能追上的，别灰心。",
      "conditions": [],
      "choices": [
        { "label": "我追", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 1 }] }
      ]
    },
    "encourage_struggle": {
      "id": "encourage_struggle",
      "text": "我看你最近 {{stats.failedSubmissionsThisWeek}} 次失败提交 — 没事，我上周也错了一堆 IndentationError。咱去问问矿头 Bug？",
      "conditions": [{ "type": "has_recent_failures" }],
      "choices": [
        { "label": "去", "nextNodeId": null, "effects": [{ "type": "quest_recommend", "questKey": "mine_replay_last_fail" }, { "type": "friendship", "delta": 2 }] }
      ]
    },
    "gift_received": {
      "id": "gift_received",
      "text": "{{giftFavorite:这正合我意，谢谢！ | 谢谢，会用上。}}",
      "conditions": [{ "type": "gift_just_given" }],
      "choices": [
        { "label": "应该的", "nextNodeId": null, "effects": [{ "type": "friendship", "delta": 3 }] }
      ]
    },
    "friendship_max": {
      "id": "friendship_max",
      "text": "{{playerName}}，跟你一起学一学期，我觉得我比以前更稳了。这本我的错题笔记送你，里面写满了我自己的笨办法。",
      "conditions": [{ "type": "friendship_min", "value": 80 }],
      "choices": [
        { "label": "我会读完", "nextNodeId": null, "effects": [{ "type": "give_item", "itemKey": "diligent_notebook" }, { "type": "set_flag", "flagKey": "student_diligent_max_friend" }] }
      ]
    }
  }
}
