<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.FeynmanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="费曼学弟" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox MinWidth="160" PlaceholderText="知识点编码" Text="{x:Bind ViewModel.KcCode, Mode=TwoWay}" />
                <Button
                    Content="开始讲解"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.StartCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Transcript, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PytCardBorderStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                Text="{x:Bind ViewModel.Verdict, Mode=OneWay}"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Verdict, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
            <TextBox
                Header="用自己的话讲给学弟听"
                PlaceholderText="例如：for 循环会把后面的代码按序列里的每个元素重复执行一次……"
                Text="{x:Bind ViewModel.Explanation, Mode=TwoWay}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="80"
                IsEnabled="{x:Bind ViewModel.HasSession, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Content="讲解"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.TeachCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSession, Mode=OneWay}" />
                <Button
                    Content="评判"
                    Command="{x:Bind ViewModel.JudgeCommand}"
                    IsEnabled="{x:Bind ViewModel.HasSession, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
