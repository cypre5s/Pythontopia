<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.WorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="百晓工坊" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="一句话描述你的需求，自动识别意图并分派到答疑 / 复盘 / 资源生成。" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBox
                Header="你想做什么？"
                PlaceholderText="例如：我想复习一下 for 循环 / 给我讲讲列表切片 / 生成一份 input 函数的讲义"
                Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
            <TextBox
                Header="知识点编码（可选，逗号分隔，资源生成必需）"
                PlaceholderText="PY43-KC-001, PY43-KC-016"
                Text="{Binding ManualKcInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button Content="识别意图并执行" Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SendCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <Button Content="学习总管编排"
                        Command="{x:Bind ViewModel.OrchestrateCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,0,12,0">
                <!-- Intent result -->
                <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.HasIntent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.IntentSummary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Intent.Reason, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AnchoredKcs, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,0" Padding="8,2" CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Dispatch note (REVIEW / VIDEO / generation status) -->
                <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.DispatchNote, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.DispatchNote, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button Content="前往 Bug 矿洞复盘"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.OpenBugMineCommand}"
                                Visibility="{x:Bind ViewModel.ShowReviewButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Tutor / orchestrator answer -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.HasAnswer, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="回答" FontWeight="SemiBold" />
                    <TextBox Text="{x:Bind ViewModel.Answer, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
                </StackPanel>

                <!-- Process trace (orchestrator) -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.HasTrace, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="编排轨迹" FontWeight="SemiBold" />
                    <TextBox Text="{x:Bind ViewModel.TraceLog, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Generated resource -->
                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.HasResource, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Bind ViewModel.ResourceMeta, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBox Text="{x:Bind ViewModel.ResourceContent, Mode=OneWay}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
