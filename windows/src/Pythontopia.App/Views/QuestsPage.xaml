<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.QuestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="任务公告板" FontSize="24" FontWeight="Bold" />
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <TextBlock Text="今日任务" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Today, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                            <TextBlock Text="{Binding Status}" FontSize="12" />
                                            <TextBlock Text="{Binding KcCode}" FontSize="12" />
                                            <TextBlock Text="{Binding NodeType}" FontSize="12" />
                                            <TextBlock Text="{Binding DueDate}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="开始" Command="{Binding DataContext.StartCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                        <Button Content="完成" Command="{Binding DataContext.CompleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                        <Button Content="跳过" Command="{Binding DataContext.SkipCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="全部任务" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.All, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                            <TextBlock Text="{Binding Status}" FontSize="12" />
                                            <TextBlock Text="{Binding KcCode}" FontSize="12" />
                                            <TextBlock Text="{Binding NodeType}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="开始" Command="{Binding DataContext.StartCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                        <Button Content="完成" Command="{Binding DataContext.CompleteCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                        <Button Content="跳过" Command="{Binding DataContext.SkipCommand, ElementName=PageRoot}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
