<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="学习者画像" FontSize="24" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="·" Opacity="0.6" />
                <TextBlock Text="{x:Bind ViewModel.Role, Mode=OneWay}" Opacity="0.8" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Profile.Major, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Profile.NarrativeSummary, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock
                Text="尚未生成画像（继续在小镇内访谈 / 做题即可积累）。"
                Opacity="0.7"
                Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" />
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <TextBlock Text="八维画像" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Dimensions, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.7">
                                        <TextBlock Text="得分" FontSize="12" />
                                        <TextBlock Text="{Binding Score, Converter={StaticResource Percent}}" FontSize="12" />
                                        <TextBlock Text="· 置信" FontSize="12" />
                                        <TextBlock Text="{Binding Confidence, Converter={StaticResource Percent}}" FontSize="12" />
                                        <TextBlock Text="· 证据" FontSize="12" />
                                        <TextBlock Text="{Binding EvidenceCount}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="−"
                                    Width="40"
                                    IsEnabled="{Binding SelfEditable}"
                                    Command="{Binding DataContext.DecreaseCommand, ElementName=PageRoot}"
                                    CommandParameter="{Binding}" />
                                <Button
                                    Grid.Column="2"
                                    Content="+"
                                    Width="40"
                                    IsEnabled="{Binding SelfEditable}"
                                    Command="{Binding DataContext.IncreaseCommand, ElementName=PageRoot}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="知识点掌握度" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Mastery, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding KcCode}" />
                                <TextBlock Grid.Column="1" Text="{Binding MasteryScore, Converter={StaticResource Percent}}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
