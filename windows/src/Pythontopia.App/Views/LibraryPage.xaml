<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="课件库" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <ComboBox
                    MinWidth="220"
                    ItemsSource="{x:Bind ViewModel.Documents}"
                    DisplayMemberPath="Title"
                    SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}" />
                <Button
                    Content="加载 PDF"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.OpenCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="22" Height="22" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PytCardBorderStyle}" Padding="0">
            <WebView2 Source="{x:Bind ViewModel.PdfSource, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
