<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.LecturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="视频讲解" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <ComboBox
                Header="章节"
                MinWidth="80"
                ItemsSource="{x:Bind ViewModel.ChapterOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.ChapterName, Mode=OneWay}" VerticalAlignment="Bottom" Opacity="0.75" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.7" FontSize="12" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Player / empty -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PytCardBorderStyle}" Padding="6">
                    <Grid>
                        <MediaPlayerElement
                            Source="{x:Bind ViewModel.VideoSource, Mode=OneWay}"
                            AreTransportControlsEnabled="True"
                            Stretch="Uniform"
                            Visibility="{x:Bind ViewModel.HasVideo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer Visibility="{x:Bind ViewModel.NoVideo, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Spacing="10" Padding="12">
                                <TextBlock Text="本章暂无在线视频" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="下面是 B 站精选讲解（外部资源，点击在浏览器打开）：" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.BiliVideos, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,4" Padding="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                                                <StackPanel Spacing="2">
                                                    <HyperlinkButton Content="{Binding Title}" NavigateUri="{Binding Link}" />
                                                    <TextBlock Text="{Binding Meta}" FontSize="11" Opacity="0.6" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" MaxLines="2" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.VideoTitle, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Sidebar: sections + learning loop -->
            <Border Grid.Column="1" Style="{StaticResource PytCardBorderStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="本章小节" FontSize="13" FontWeight="SemiBold" Opacity="0.8" />

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedVideo, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" FontSize="11" Opacity="0.6" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Spacing="8">
                        <TextBlock Text="学习闭环" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                        <Button Content="看完去做题" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Click="OnGoTraining" />
                        <Button Content="课件库 / PPT" HorizontalAlignment="Stretch" Click="OnGoLibrary" />
                        <Button Content="返回小镇" HorizontalAlignment="Stretch" Click="OnGoTown" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
