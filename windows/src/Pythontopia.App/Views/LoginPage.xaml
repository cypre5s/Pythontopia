<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border
            Style="{StaticResource PytCardBorderStyle}"
            MaxWidth="380"
            Padding="32"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrandHeaderBrush}">
                        <FontIcon Glyph="&#xE80F;" FontSize="22" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pythontopia" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="像素学习小镇 · 桌面端" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <TextBox
                    Header="用户名"
                    PlaceholderText="3-64 位，字母数字 _ . -"
                    Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />

                <TextBox
                    Header="昵称"
                    PlaceholderText="可选"
                    Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsRegisterMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <PasswordBox
                    Header="密码"
                    PlaceholderText="8-72 位"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

                <Button
                    Content="{x:Bind ViewModel.SubmitLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    HorizontalAlignment="Stretch"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />

                <HyperlinkButton
                    Content="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleModeCommand}"
                    HorizontalAlignment="Center" />

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    HorizontalAlignment="Center" />

                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
