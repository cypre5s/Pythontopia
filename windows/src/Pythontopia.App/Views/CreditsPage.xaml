<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pythontopia.App.Views.CreditsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="14" MaxWidth="860">
            <TextBlock Text="Pythontopia 致谢" FontSize="24" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8">
                本项目代码以 MIT License 发布；像素美术、音效与字体资产按分层授权，覆盖
                CC0 / CC-BY 3.0 / CC-BY 4.0 / CC-BY-SA 3.0 / OFL-1.1 多个协议族。
                完整逐项署名见仓库根 LICENSE-ART.md 与 frontend/public/assets/pixel/LICENSE.md。
            </TextBlock>

            <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="CC0 1.0（公共领域）" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8" Text="署名推荐、无传染。Kenney 等 CC0 像素瓦片 / UI / 音效，可自由使用。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="CC-BY 3.0 / 4.0（署名）" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8" Text="强制署名、无传染。需保留原作者署名，详见 LICENSE-ART.md 对应条目。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="CC-BY-SA 3.0（署名 · 相同方式共享）" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8" Text="强制署名 + 传染（Share-Alike）。LPC 角色/素材采用，包装作品同步以 CC-BY-SA 3.0+ 发布；代码层仍为 MIT。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PytCardBorderStyle}" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="OFL-1.1（开放字体许可）" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.8" Text="像素字体（如 Zpix 等）随作品分发，遵循 SIL Open Font License 1.1。" />
                </StackPanel>
            </Border>

            <TextBlock
                TextWrapping="Wrap"
                FontSize="12"
                Opacity="0.6"
                Text="本声明页面是软件运行时合规的一部分。如发现条目缺漏或需补充作者，请在仓库根 LICENSE-ART.md 提交补丁。" />
        </StackPanel>
    </ScrollViewer>
</Page>
