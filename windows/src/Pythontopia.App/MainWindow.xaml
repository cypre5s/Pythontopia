<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pythontopia.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: brand badge + name on the left; the system draws the caption buttons. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource BrandHeaderBrush}">
                    <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Text="Pythontopia" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="像素学习小镇" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="新手引导" Tag="GuidePage" Icon="Help" />
                <NavigationViewItem Content="小镇" Tag="TownPage" Icon="Home" />
                <NavigationViewItem Content="主线" Tag="MainlinePage" Icon="Map" />
                <NavigationViewItem Content="学习路径" Tag="PathPage" Icon="Flag" />
                <NavigationViewItem Content="画像" Tag="ProfilePage" Icon="Contact" />
                <NavigationViewItem Content="任务公告板" Tag="QuestsPage" Icon="List" />
                <NavigationViewItem Content="课程" Tag="CoursePage" Icon="Library" />
                <NavigationViewItem Content="例题" Tag="ExamplesPage" Icon="Bookmarks" />
                <NavigationViewItem Content="课件库" Tag="LibraryPage" Icon="Page2" />
                <NavigationViewItem Content="B站精选" Tag="BilibiliPage" Icon="Video" />
                <NavigationViewItem Content="训练场" Tag="PracticePage" Icon="Play" />
                <NavigationViewItem Content="章节测验" Tag="ChapterTestPage" Icon="Document" />
                <NavigationViewItem Content="费曼学弟" Tag="FeynmanPage" Icon="Microphone" />
                <NavigationViewItem Content="百晓工坊" Tag="WorkshopPage" Icon="Message" />
                <NavigationViewItem Content="AI 配图" Tag="MediaPage" Icon="Camera" />
                <NavigationViewItem Content="Bug 矿洞" Tag="BugMinePage" Icon="Repair" />
                <NavigationViewItem Content="Boss 副本" Tag="BossPage" Icon="Important" />
                <NavigationViewItem Content="无尽模式" Tag="EndlessPage" Icon="Sync" />
                <NavigationViewItem Content="复盘大厅" Tag="ReviewHallPage" Icon="Refresh" />
                <NavigationViewItem Content="学情洞察" Tag="InsightsPage" Icon="Comment" />
                <NavigationViewItem Content="班级" Tag="ClassroomPage" Icon="People" />
                <NavigationViewItem Content="日历" Tag="CalendarPage" Icon="Calendar" />
                <NavigationViewItem Content="存档" Tag="SavesPage" Icon="Save" />
                <NavigationViewItem Content="技能" Tag="SkillsPage" Icon="Favorite" />
                <NavigationViewItem Content="NPC" Tag="NpcPage" Icon="Contact2" />
            </NavigationView.MenuItems>

            <NavigationView.PaneCustomContent>
                <StackPanel
                    x:Name="UserPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    Padding="14,8"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                    <TextBlock
                        x:Name="UserText"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="退出登录" Tag="Logout" Icon="BlockContact" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
