<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pythontopia.App</RootNamespace>
    <AssemblyName>Pythontopia.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Native Windows metadata (shown in file properties / task manager) + zh-CN as the neutral culture. -->
    <Version>1.0.0</Version>
    <AssemblyTitle>Pythontopia 像素学习小镇</AssemblyTitle>
    <Product>Pythontopia</Product>
    <Company>Pythontopia</Company>
    <Authors>Pythontopia</Authors>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged (no MSIX): runs as a plain .exe; bundle the Windows App SDK runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <!-- Resolve the Windows App SDK's win10-* native assets on .NET 8 (silences NETSDK1206). -->
    <UseRidGraph>true</UseRidGraph>
  </PropertyGroup>

  <!-- Release hardening: ship no PDBs / debug symbols (removes method/local names; raises the
       reverse-engineering bar). The client carries no judging/answer logic (all server-side),
       so binaries expose only API call shapes, not exploitable secrets. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Precompile IL to native (ReadyToRun): faster cold start + raises the reverse-engineering bar. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240607001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pythontopia.Core\Pythontopia.Core.csproj" />
  </ItemGroup>

</Project>
