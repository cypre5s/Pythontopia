.stage__hero {
  background: linear-gradient(180deg, #efdcb8 0%, #fff8ea 100%);
}

.stage__title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--wood-dark);
  margin: 8rpx 0 12rpx;
}

.stage__flags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stage__hint {
  margin-top: 12rpx;
}

.bar {
  margin: 14rpx 0;
}

/* 看 · 视频 */
.stage-video {
  margin-top: 16rpx;
}

.stage-video__title {
  font-size: 28rpx;
  color: var(--ink);
}

.stage-video__player {
  width: 100%;
  height: 380rpx;
  margin-top: 10rpx;
  border: 4rpx solid var(--wood-dark);
}

/* 学 · 课件页 */
.stage__study-actions {
  margin: 14rpx 0;
}

.stage-page {
  margin-top: 16rpx;
  border: 4rpx solid var(--wood-dark);
  background: #fffdf6;
  box-shadow: 6rpx 6rpx 0 0 rgba(90, 62, 27, 0.25);
}

.stage-page__img {
  width: 100%;
  display: block;
  background: #fff;
}

.stage-page__foot {
  padding: 12rpx 16rpx;
  border-top: 3rpx dashed var(--wood);
}

/* 练 · 客观题 */
.stage-q {
  padding: 20rpx 0;
  border-top: 3rpx dashed var(--wood);
}

.stage-q:first-of-type {
  border-top: none;
}

.stage-q__stem {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
}

.stage-q__no {
  font-weight: bold;
  margin-right: 4rpx;
}

.stage-q__kind {
  color: var(--ink-soft);
  font-size: 24rpx;
  margin-right: 6rpx;
}

.stage-q__tick {
  margin-left: 8rpx;
  color: var(--leaf-deep);
  font-weight: bold;
}

/* 客观题选项 / 填空样式见全局 app.wxss（小节练习 + 章末测试共用）。 */

.stage-q__foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.stage-result {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 3rpx solid var(--wood);
  background: #fffdf6;
}

.stage-result--ok {
  border-color: var(--leaf);
  background: #eef6e8;
}

.stage-result--bad {
  border-color: var(--berry);
  background: #f8e8e4;
}

.stage-result__verdict {
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stage-result__line {
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

.stage__test-entry {
  margin-top: 8rpx;
}
