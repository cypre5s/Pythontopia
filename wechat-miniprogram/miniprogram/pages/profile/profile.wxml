<view class="page">
  <view class="card profile__head">
    <view class="profile__name">{{displayName || username || '学习者'}}</view>
    <view class="muted">@{{username}}</view>
    <view wx:if="{{major}}" class="muted">专业：{{major}}</view>
  </view>

  <view wx:if="{{narrative}}" class="card">
    <view class="section-title">画像速写</view>
    <view class="profile__narrative">{{narrative}}</view>
  </view>
  <view wx:elif="{{!hasProfile}}" class="card card--flat">
    <view class="muted">画像尚未初始化。完成对话访谈、练习与任务后，八维画像会被动更新。</view>
  </view>

  <view class="login__error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  <view wx:if="{{loading && dimensions.length === 0}}" class="loading">加载画像…</view>

  <view class="card">
    <view class="section-title">八维画像</view>
    <view class="muted profile__legend">绿色=得分 · 金色=置信度。可自评维度可手动微调。</view>

    <view class="profile__dim" wx:for="{{dimensions}}" wx:key="key">
      <view class="row row--between">
        <text class="profile__dim-label">{{item.label}}</text>
        <text class="profile__dim-score">{{item.percent}}</text>
      </view>
      <view class="bar"><view class="bar__fill" style="width:{{item.width}}"></view></view>

      <view class="row row--between profile__dim-meta">
        <text class="muted">置信度 {{item.confidence}} · 证据 {{item.evidenceCount}}</text>
        <text wx:if="{{item.selfEditable}}" class="tag">可自评</text>
      </view>
      <view class="bar bar--thin"><view class="bar__fill bar__fill--gold" style="width:{{item.confidenceWidth}}"></view></view>

      <view wx:if="{{item.lowConfidence}}" class="muted profile__low">信号不足，结论仅供参考。</view>

      <view wx:if="{{item.tags.length > 0}}" class="profile__tags">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>

      <view wx:if="{{item.selfEditable}}" class="profile__adjust">
        <button
          class="btn btn--sm btn--ghost"
          data-key="{{item.key}}"
          data-dir="down"
          disabled="{{updatingKey}}"
          bindtap="onAdjust"
        >- 0.1</button>
        <button
          class="btn btn--sm btn--primary"
          data-key="{{item.key}}"
          data-dir="up"
          disabled="{{updatingKey}}"
          bindtap="onAdjust"
        >+ 0.1</button>
      </view>
    </view>
  </view>

  <button class="btn btn--danger btn--block" bindtap="onLogout">退出登录</button>
</view>
